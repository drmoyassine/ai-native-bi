# Make .env from this file with every secret filled in:  python3 scripts/make_env.py  (never put real secrets here: it is committed)

# ---- The BI on its own (compose.yaml) ----------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# The BI's own database. In co-deployment (compose.together.yaml) this is a database and role on the AMS's PostgreSQL server,
# created at start-up through BI_DATABASE_ADMIN_URL (DEC-034 in the AMS repo).
DATABASE_URL=
# Optional: a superuser address on the same server. When set, the BI creates its role and database (from DATABASE_URL) if missing.
BI_DATABASE_ADMIN_URL=
PORT=4000
# The app's own address, e.g. https://bi.example.edu: the MCP server is at PUBLIC_URL/mcp and accepts only requests naming this host.
PUBLIC_URL=
MCP_CALLS_PER_MINUTE=60
MCP_CALLS_PER_DAY=2000
# The AMS as the BI's authorization server (contract 6.2): people sign in to the MCP server with their AMS account. The issuer is
# {AMS APP_URL}/api/auth; tokens must name OAUTH_AUDIENCE (default PUBLIC_URL/mcp), which is the AMS's BI_OAUTH_AUDIENCE.
AMS_OAUTH_ISSUER=
OAUTH_AUDIENCE=
# The first administrator: made at start if this email has no account yet (an existing account is never changed). Set both, or neither
# and make one with `python -m bi.main_user`. The password has at least 12 characters; choose it, it is not generated.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- The AMS (docs/ams-bi-contract-v0.md) -------------------------------------------------------------------------------------
# The key the AMS sends as `Authorization: Bearer ...` (the AMS's BI_API_KEY). Required.
BI_API_KEY=
# The origin the AMS's callback addresses must have (the AMS's APP_PUBLIC_URL). The BI refuses to call back anywhere else, so a
# caller with the key cannot make the BI post to an address of its choosing. Co-deployment: http://app:3000
AMS_CALLBACK_ORIGIN=https://ams.example.org

# ---- The metric layer (Cube) and loaded files -----------------------------------------------------------------------------------
# Cube's API secret (also CUBEJS_API_SECRET in compose): the worker signs its queries with it. At least 32 characters. Required.
CUBE_API_SECRET=
# The database role Cube connects as, which may read analytics only. bi-api creates it at start and grants it. Required.
CUBE_DB_USER=bi_cube
CUBE_DB_PASSWORD=
# Where loaded files are kept unchanged. Default: the biraw volume. A bucket: s3://<bucket> with S3_ENDPOINT_URL (e.g. Garage) and
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
RAW_FILES_URL=file:///data/raw-files
S3_ENDPOINT_URL=

# ---- The agent ------------------------------------------------------------------------------------------------------------------
# The key of the secret store (model-provider keys are kept encrypted with it): 32 random bytes, base64url. Made by make_env.py; losing
# it makes the stored keys unreadable, so keep a copy with the rest of .env.
BI_SECRETS_KEY=
# Monthly token budgets (input plus output): a hard cap for the institution, a share for each person.
AGENT_INSTITUTION_MONTHLY_TOKENS=100000000
AGENT_PERSON_MONTHLY_TOKENS=10000000
# Counts under this are hidden from the agent. The real value comes from the privacy rules (TASK-002).
SUPPRESSION_THRESHOLD=5

# ---- The app (web, sign-in, uploads) -------------------------------------------------------------------------------------------
# The session cookie is sent over HTTPS only. Set false only to use the app over plain http on an address other than localhost.
APP_COOKIE_SECURE=true

# ---- Co-deployment only (compose.together.yaml) -------------------------------------------------------------------------------
# Where the AMS checkout is (built from its own Dockerfile). Its .env must also say:
#   BI_BASE_URL=http://bi-api:4000  BI_PRIVATE_HOST=bi-api  BI_API_KEY=<same as above>  APP_PUBLIC_URL=http://app:3000
AMS_DIR=../ams
# The AMS's PostgreSQL superuser (its POSTGRES_USER / POSTGRES_PASSWORD), used once to create the BI's role and database.
AMS_POSTGRES_USER=ams
AMS_POSTGRES_PASSWORD=
BI_DB_PASSWORD=
